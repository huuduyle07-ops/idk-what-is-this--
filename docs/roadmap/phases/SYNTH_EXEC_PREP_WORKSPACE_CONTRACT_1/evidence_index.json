      "anchors": [
        {
          "line": 25,
          "text": "\"meaning\": \"Obtain the exact existing frozen byte literal in memory; no synthesis, transformation, newline conversion or filesystem write. Authenticate the original pinned authorization and its source identity before any materialization; co"
        },
        {
          "line": 28,
          "text": "\"sandbox_materialization\": {"
        },
        {
          "line": 65,
          "text": "\"materialization\": {"
        },
        {
          "line": 210,
          "text": "\"source authentication and materialization readback hash/size/path\","
        },
        {
          "line": 215,
          "text": "\"workspace live/artifact-integrity state; cleanup pending\","
        },
        {
          "line": 221,
          "text": "\"cleanup_state_at_success\": \"LIVE_EPHEMERAL_ARTIFACTS_CLEANUP_PENDING\","
        },
        {
          "line": 222,
          "text": "\"cleanup_success_claimed_at_preparation_success\": false,"
        },
        {
          "line": 226,
          "text": "\"materialization and full readback\","
        },
        {
          "line": 232,
          "text": "\"cleanup pending\""
        },
        {
          "line": 240,
          "text": "\"cleanup\": {"
        },
        {
          "line": 241,
          "text": "\"owner\": \"Proposed preparation owner owns attempt workspace lifecycle; future consumer borrows an exclusive artifact handoff; bound sandbox controller performs cleanup and independent absence observation.\","
        },
        {
          "line": 242,
          "text": "\"on_preparation_failure\": \"No ready receipt. Kill/reap compiler children/process groups, close pipes/selectors and observe EOF, tear down entire workspace/container, independently verify absence. Failed cleanup is separately recorded and bl"
        },
        {
          "line": 243,
          "text": "\"after_preparation_success\": \"Keep exact source/class in same ephemeral workspace only until consumer completion, abort, timeout or authorization/readiness loss. Receipt states live artifacts with cleanup pending; no premature removal or cl"
        },
        {
          "line": 244,
          "text": "\"after_behavior_or_abandonment\": \"Reap every child/process group, close captures, remove whole scenario container/workspace including /work and /tmp, independently verify absence and record separate cleanup evidence. Consumer failure spends"
        },
        {
          "line": 245,
          "text": "\"persistent_artifacts\": \"No source, class, harness, workspace snapshot or raw byte dump survives final cleanup. Bounded source-free/class-free metadata reports, sizes, hashes, manifests and cleanup observations may survive as report-only au"
        },
        {
          "line": 246,
          "text": "\"preparation_success_implies_cleanup_success\": false,"
        },
        {
          "line": 247,
          "text": "\"cleanup_failure_is_behavior_success\": false,"
        },
        {
          "line": 248,
          "text": "\"cleanup_authority_is_repository_write_authority\": false"
        },
        {
          "line": 252,
          "text": "\"sandbox_materialization_authority\": false,"
        },
        {
          "line": 253,
          "text": "\"exact_sandbox_materialization_authority\": false,"
        },
        {
          "line": 282,
          "text": "\"preparation_authority\": false,"
        },
        {
          "line": 294,
          "text": "\"preparation_authority_issuance\": 0,"
        },
        {
          "line": 297,
          "text": "\"source_materialization\": 0,"
        },
        {
          "line": 345,
          "text": "\"proposal\": \"sandbox_materialization\","
        },
        {
          "line": 376,
          "text": "\"rationale\": \"All preparation and full harness/consumer readiness evidence precede runtime consumption. Only mandatory authenticated permission checks/commits intervene before dispatch; no materialization, compilation, artifact repair or re"
        },
        {
          "line": 409,
          "text": "\"source_evidence_method\": \"Read and AST-evaluate the existing _SOURCE literal only; no owner import, executable Java check or source materialization.\","
        },
        {
          "line": 435,
          "text": "\"id\": \"materialization\","
        },
        {
          "line": 491,
          "text": "\"id\": \"cleanup\","
        },
        {
          "line": 501,
          "text": "\"cleanup_is_preparation\": false,"
        },
        {
          "line": 502,
          "text": "\"cleanup_clarification\": \"Mandatory teardown, child reaping and independent absence verification after completion or abort remain cleanup duties; they do not permit another preparation attempt after runtime consumption.\""
        },
        {
          "line": 504,
          "text": "\"preparation_authority\": {"
        },
        {
          "line": 508,
          "text": "\"schema\": \"synthetic_preparation_authority_pinned_1_v1\","
        },
        {
          "line": 511,
          "text": "\"exact_sandbox_materialization_authority\","
        },
        {
          "line": 516,
          "text": "\"sandbox_materialization_authority\": \"Proposed independent exact preparation owner; only a live original preparation authority's materialization facet, delegated to its bound already-authorized sandbox controller, may permit the single excl"
        },
        {
          "line": 517,
          "text": "\"scenario_compilation_authority\": \"The same proposed owner, separately scoped compilation facet, permits one fixed compiler attempt after verified materialization. It is not inherited from pinned auth, runtime lease, reflection permissions,"
        },
        {
          "line": 521,
          "text": "\"preparation_authority_design\": \"One narrow one-shot preparation authority plus one immutable success receipt. Two non-interchangeable operation facets bind one fixed materialize-then-compile attempt. No generic file or command API; no inde"
        },
        {
          "line": 524,
          "text": "\"proposed_authority_schema\": \"synthetic_preparation_authority_pinned_1_v1\","
        },
        {
          "line": 526,
          "text": "\"exact_sandbox_materialization_authority\","
        },
        {
          "line": 555,
          "text": "\"compilation_requires_verified_materialization\": true,"
        },
        {
          "line": 556,
          "text": "\"materialization_facet_can_compile\": false,"
        },
        {
          "line": 571,
          "text": "\"obtained_bytes_not_equal_to_materialization\": true,"
        },
