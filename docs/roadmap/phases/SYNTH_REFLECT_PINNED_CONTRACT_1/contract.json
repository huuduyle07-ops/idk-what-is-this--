    "readiness_error_delivery": "Authentication/role/scope failures raise typed categories. Authenticated terminal lease returns both reflection readiness flags false with terminal reason. Authentic wrong runtime state yields requested readiness false with PINNED_RUNTIME_STATE_MISMATCH. Local/active success still returns behavioral_activation_ready=false and PROOF_UNRESOLVED. Mutating operations raise on the same failed gates.",
    "optional_role_rule": "If supplied, exact semantic role must equal retained role and fixed request-role mapping; otherwise retained role is used."
  },
  "error_taxonomy": {
    "PINNED_AUTH_UNAUTHENTICATED": "wrong exact pinned auth class, nonoriginal/copy/missing live registry/signature or rejected exact upstream identity; retain upstream code/reason",
    "PINNED_RUNTIME_LEASE_UNAUTHENTICATED": "wrong exact pinned runtime class, nonoriginal/copy/missing live record/signature or supplied auth not exact retained original",
    "PINNED_AUTH_SCOPE_MISMATCH": "known pinned auth scope failure; preserve category and upstream code/reason",
    "PINNED_PROVIDER_PROVENANCE_MISMATCH": "known retained pinned provider graph/requirement/image/sandbox/controller/cleanup failure; preserve category and upstream code/reason",
    "PINNED_RUNTIME_STATE_MISMATCH": "authenticated runtime state differs from operation requirement; not an authentication failure",
    "REFLECTION_REQUEST_UNAUTHENTICATED": "unchanged request public authentication rejects exact request/original/PID/signature",
    "REFLECTION_SCOPE_MISMATCH": "authenticated scenario/source/definition/invocation/field/read/renderer projection mismatch; never relabeled authentication failure",
    "REFLECTION_ADMISSION_UNAUTHENTICATED": "wrong exact new admission class, nonoriginal/missing live registry/signed record or wrong supplied original request/runtime/admission binding",
    "DUPLICATE_REFLECTION_ADMISSION": "permanent authenticated runtime/role/scope admission key already exists, even after terminal state or collection",
    "REFLECTION_LEASE_UNAUTHENTICATED": "wrong exact new lease class, nonoriginal/missing live registry/signed immutable/current-state record or wrong supplied original admission/request/runtime binding",
    "DUPLICATE_REFLECTION_LEASE": "permanent authenticated admission key already leased, including terminal or collected lease",
    "REFLECTION_LEASE_ALREADY_CONSUMED": "authenticated reflection lease CONSUMED when ISSUED required",
    "REFLECTION_LEASE_INVALIDATED": "authenticated reflection lease INVALIDATED when ISSUED required",
    "REFLECTION_ROLE_MISMATCH": "unsupported exact role or supplied role disagrees with retained role/request mapping",
    "REFLECTION_WRONG_PROCESS": "owner or authenticated supplied handle issuing PID differs; reject before inherited owner lock",
    "PROOF_UNRESOLVED": "unknown upstream validator failure, unavailable proof or unresolved downstream behavioral/source/compile dependency; fail closed and preserve upstream code/reason"
  },
