        },
        {
          "line": 95,
          "text": "(\"containment\", \"Private PID/cgroup; IPC none; all seven measured namespaces; identical child/controller namespace and cgroup boundaries before/after.\"),"
        },
        {
          "line": 97,
          "text": "(\"controller_threads\", \"One Python and OS controller thread before/after; zero Thread.start attempts; frozen selector capture.\"),"
        },
        {
          "line": 98,
          "text": "(\"capture\", \"10000 ms outer timeout, 5000 ms abort/shared controller deadline; independent bounded pipes/EOF; outer stdout/stderr 8192 each, version/runtime 1024 each, compiler 2048 each.\"),"
        },
        {
