      "anchors": [
        {
          "line": 31,
          "text": "\"Authenticate that the runtime controller is that same measured executable in that same immutable image.\","
        },
        {
          "line": 32,
          "text": "\"Bind controller source identity and frozen JAVA.1C invocation to the runtime evidence digest.\","
        },
        {
          "line": 33,
          "text": "\"JAVA.1C currently lacks a controller binary identity field; an additive authenticated measurement attachment is required.\","
        },
        {
          "line": 34,
          "text": "\"No stable fixed controller digest is established for requirement pinning; historical report hashes cannot supply it.\","
        },
