    "trigger": "Line-by-line re-audit of the DATA.ROLLBACK.1 specification against delivered code.",
    "gaps_closed": [
      {
        "id": "lifecycle_shadow_input",
        "finding": "core/run_lifecycle.py fed the narrowed rollback_performed into the frozen post-run shadow, so an incomplete rollback stopped marking observed_change_identity_incomplete.",
        "resolution": "The shadow input receives the typed attempted fact; failure before mutation still does not mark it."
      },
      {
        "id": "lifecycle_rollback_event",
        "finding": "Replay events.jsonl logged rollback_performed on verified success but nothing when recovery was incomplete.",
        "resolution": "A rollback_incomplete event carries status, unresolved paths/directories, artifact IDs and material error."
      },
      {
        "id": "partial_material_wording",
        "finding": "Executor, plan executor, telemetry and web messages said emergency material 'is available' when only some unresolved targets were persisted.",
        "resolution": "One presenter over the outcome distinguishes available, partially available, not fully persisted and not recorded; not_attempted no longer reads as failed."
      },
      {
        "id": "typed_success_precedence",
        "finding": "rollback_outcome_from_mapping accepted a typed completed_verified beside measured recovery_complete=false or non-empty remaining sets.",
        "resolution": "Such conflicting evidence loads as unverifiable (conflicting_rollback_evidence)."
      },
      {
        "id": "absent_receipt_final_state",
        "finding": "A non-mapping receipt loaded with final_state_verified=true.",
        "resolution": "It loads as not_required with final_state_verified=false."
      },
      {
        "id": "static_ownership_breadth",
        "finding": "The static guard covered only literal rollback_performed=True in seven files.",
        "resolution": "Literal rollback_completed/rollback_verified/rollback_status=completed_verified writes are guarded across producers and translators, and verified-success construction is pinned to its two measuring owners."
      },
      {
        "id": "undo_separation_test",
        "finding": "No test proved DATA.UNDO.1 refuses emergency artifact IDs, although both use 64-hex IDs.",
        "resolution": "Undo refuses the ID and even the copied manifest/bytes; the emergency store exposes no restore/consume API."
      },
      {
        "id": "apply_failure_info_single_outcome",
        "finding": "/apply_patch merged executor failure_info.rollback_code/rollback_reason with telemetry's final rollback_failure, so a final observation refuting a verified restore left two rollback accounts in one payload.",
        "resolution": "failure_info keeps its validation cause while its rollback code and reason are rendered from the final outcome."
      }
    ],
