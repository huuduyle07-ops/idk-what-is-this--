# ============================================================================
# AI Project Environment Configuration
# ============================================================================

# --- PYTHON VERSION REQUIREMENTS ---
# Main environment: Python 3.13+
# Tree-sitter environment: Python 3.12.13 (for tree-sitter-language-pack compatibility)
# To switch: source /path/to/py312-env/bin/activate

# --- DEPLOYMENT ENVIRONMENT ---
# Options: "local" (default) or "docker"
# Determines which DATABASE_URL to use
APP_ENV=local

# --- API KEYS (REQUIRED) ---
# Generate at: https://aistudio.google.com/app/apikeys
GOOGLE_API_KEY=your_google_api_key_here

# Generate at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
HF_TOKEN=your_huggingface_token_here
EMBEDDING_MODEL=your_embedding_model_here

# Set false in Codespaces/benchmark to avoid Hugging Face rate limits
ROUTER_USE_EMBEDDINGS=false
INDEX_USE_EMBEDDINGS=false
RETRIEVER_USE_EMBEDDINGS=false
RETRIEVER_USE_DB=false

# --- DATABASE CONFIGURATION ---
DB_ENABLED=false
# PostgreSQL connection credentials
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=codex_db

# Connection string for Docker environment (app inside container)
DATABASE_URL_DOCKER=postgresql://myuser:mypassword@db:5432/codex_db

# Connection string for local environment (app on host machine)
DATABASE_URL_LOCAL=postgresql://myuser:mypassword@localhost:5432/codex_db

# Fallback: Used if DATABASE_URL_DOCKER/LOCAL not set
# DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/codex_db

# --- OLLAMA / LOCAL CRITIC ---
# Enable the "Local Critique" button in the web UI (requires Ollama running locally)
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
LOCAL_REVIEWER_MODEL=deepseek-r1:1.5b
# Set true to expose the raw <think> chain-of-thought in the UI debug panel
SHOW_LOCAL_THOUGHT=false

# --- COST TRACKING ---
# Built-in Gemini estimates use paid standard text/image/video rates captured
# 2026-05-18. Override models here if your tier or provider pricing differs.
# MODEL_COST_OVERRIDES_JSON={"gemma-4-31b-it":{"input_per_1m":0,"output_per_1m":0,"source":"manual"}}

# --- SAFETY REVIEW / PROPOSAL GENERATION ---
#Lesson auto-activation: when true, any lesson created with a non-empty "activation_criteria" will be automatically marked active and injected into the prompt. Default false to avoid unintended behavior changes.
LESSON_AUTO_ACTIVE = false


LESSON_RETRIEVAL_ENABLED = true
LESSON_RETRIEVAL_LIMIT = 5
LESSON_RETRIEVAL_MAX_CHARS = 3000

# Phase 13.11a: Memory Temperature tie-breaker, wired into lesson retrieval but
# DISABLED by default. Leave false for unchanged live behavior; set true only
# for controlled local experiments. When enabled it only reorders near-equal
# lessons by thermal band (tie-break only) — scores preserved, cold never
# hard-filtered, frozen/audit-only/blocked never surfaced.
MEMORY_TEMPERATURE_RETRIEVAL_ENABLED = false
MEMORY_TEMPERATURE_TIEBREAK_ONLY = true

# curl --ssl-no-revoke -i -L -H "x-webhook-secret: secret_key" "webhook_link_from_n8n_here"